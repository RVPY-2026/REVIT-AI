# Copy to .env.local and fill in. Never commit .env.local.

# true = no database/auth needed; data from src/mocks, role switcher in dev
NEXT_PUBLIC_USE_MOCK=true

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for Storage admin tasks (signed URLs, backups)
SUPABASE_SECRET_KEY=

# Supabase → Connect → Transaction pooler (port 6543) — used by the app
DATABASE_URL=
# Supabase → Connect → Session pooler / direct (port 5432) — used by drizzle-kit migrations
DATABASE_URL_DIRECT=

# Random string ≥ 16 chars; Vercel Cron sends it as a Bearer token
CRON_SECRET=
