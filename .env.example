# Copy to .env.local and fill in. Never commit .env.local.

# true = no database/auth needed; data from src/mocks, role switcher in dev
NEXT_PUBLIC_USE_MOCK=true

# Public origin, e.g. https://rvpy.vn (metadata, OG image, sitemap). Vercel's production URL is used when empty.
NEXT_PUBLIC_SITE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Consulting Zalo account phone for the floating "Chat Zalo" button. Empty = button links to the groups.
NEXT_PUBLIC_ZALO_CONSULT_PHONE=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for Storage admin tasks (signed URLs, backups)
SUPABASE_SECRET_KEY=

# Supabase → Connect → Transaction pooler (port 6543) — used by the app
# Require TLS on hosted connections: append ?sslmode=require to each database URL.
DATABASE_URL=
# Supabase → Connect → Session pooler / direct (port 5432) — used by drizzle-kit migrations
DATABASE_URL_DIRECT=

# Random string ≥ 16 chars; Vercel Cron sends it as a Bearer token
CRON_SECRET=

# Signup protection. Generate a separate random >=32 character secret for hashing rate-limit keys.
SIGNUP_RATE_LIMIT_SECRET=
# Cloudflare Turnstile widget restricted to the public hostname. Required for production signups.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only Zalo Bot credential. Never prefix with NEXT_PUBLIC_.
ZALO_BOT_TOKEN=
# Optional publicly accessible HTTPS image for the local connection test.
ZALO_BOT_TEST_PHOTO_URL=
# Generate a random secret of at least 32 characters for Zalo's webhook header.
ZALO_BOT_WEBHOOK_SECRET=
# Public HTTPS image URL to send after staff confirms the student starts trial.
ZALO_BOT_THANKS_IMAGE_URL=
# Optional public HTTPS photos interleaved with onboarding messages.
ZALO_BOT_COMMUNITY_IMAGE_URL=
ZALO_BOT_OFFER_IMAGE_URL=
ZALO_BOT_REFERRAL_IMAGE_URL=
ZALO_BOT_PREP_IMAGE_URL=
# Public profile link for the bot, once available; shown on the signup confirmation page.
NEXT_PUBLIC_ZALO_BOT_URL=
